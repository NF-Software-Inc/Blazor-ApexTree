@page "/"
@inherits ComponentBase

<PageTitle>Blazor Apex Tree</PageTitle>

<section class="section">
    <div class="container">
        @foreach (var group in Groups)
        {
            <h2 class="title is-5 example-group-heading">@group.Heading</h2>
            <div class="columns is-multiline mb-5">
                @foreach (var example in group.Items)
                {
                    <div class="column is-4-desktop is-6-tablet">
                        <a href="@example.Url" class="card example-card">
                            <div class="card-content">
                                <div class="media mb-3">
                                    <div class="media-left">
                                        <span class="icon example-card-icon has-text-link">
                                            <span class="material-icons">@example.Icon</span>
                                        </span>
                                    </div>
                                    <div class="media-content">
                                        <p class="title is-5 mb-0">@example.Title</p>
                                    </div>
                                </div>
                                <div class="content">
                                    @example.Description
                                </div>
                                @if (example.IsNew)
                                {
                                    @* Sits at the card foot rather than beside the title: in the header
                                       it stole enough width to wrap two-word titles onto a second line,
                                       leaving badged and unbadged cards in a row visibly ragged. *@
                                    <span class="tag is-link is-light example-card-badge" title="Added in Blazor-ApexTree 11.0.0">New in 11.0</span>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>
